# Copy to supabase/functions/.env.local (ignored). Upload via Supabase secrets.
# Never put these secrets in EXPO_PUBLIC_* or NEXT_PUBLIC_* variables.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
RAZORPAY_MODE=test
RAZORPAY_LIVE_ENABLED=false
# Route must be approved/enabled for your marketplace by Razorpay. Independent
# gates protect transfers in addition to ordinary checkout live enablement.
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_LIVE_ENABLED=false
# Optional: merchant account restriction and previous secret during rotation.
# RAZORPAY_ACCOUNT_ID=acc_REPLACE_ME
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=PREVIOUS_WEBHOOK_SECRET
