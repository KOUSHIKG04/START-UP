# Trusted tooling only. Never copy database credentials into mobile/web apps.
# Bun loads this file for the optional seed; Drizzle Kit loads it explicitly.
NODE_ENV=development
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Separate disposable database, already migrated using Supabase CLI:
# TEST_DATABASE_URL=
# ALLOW_DATABASE_TESTS=I_UNDERSTAND_THIS_IS_A_DISPOSABLE_DATABASE
