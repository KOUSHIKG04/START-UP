NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server only. Enable Google Geocoding API for automatic facility address lookup.
GOOGLE_GEOCODING_API_KEY=YOUR_SERVER_RESTRICTED_KEY
# Browser key. Enable Maps JavaScript API and restrict this key to your portal's website origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_WEBSITE_RESTRICTED_KEY
