{
  "name": "startup",
  "version": "0.1.0",
  "private": true,
  "description": "Startup platform monorepo",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web dev",
    "supabase": "supabase",
    "db:generate": "pnpm --filter @startup/database db:generate",
    "db:check": "supabase db push --linked --dry-run --skip-vault",
    "db:migrate": "supabase db push --linked",
    "dev:patient": "pnpm --filter patient-mobile start",
    "dev:patient:tunnel": "pnpm --filter patient-mobile start -- --tunnel",
    "dev:doctor": "pnpm --filter doctor-mobile start",
    "dev:doctor:tunnel": "pnpm --filter doctor-mobile start -- --tunnel",
    "dev:driver": "pnpm --filter driver-mobile start",
    "dev:driver:tunnel": "pnpm --filter driver-mobile start -- --tunnel",
    "patient:tunnel": "pnpm --filter patient-mobile start -- --tunnel",
    "doctor:tunnel": "pnpm --filter doctor-mobile start -- --tunnel",
    "driver:tunnel": "pnpm --filter driver-mobile start -- --tunnel",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web exec playwright test",
    "test:e2e:ui": "pnpm --filter web exec playwright test --ui"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "2.117.0"
  }
}
